# Nunca subir credenciales ni acceso al laboratorio
*.ovpn
*.pem
*.key
*.crt
*.p12
.env
.env.*
credenciales*
secrets*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Resultados de laboratorio y capturas
*.pcap
*.pcapng
resultados/raw/
*.log

# PDFs generados a partir de Markdown (el fuente es el .md).
# Los documentos de referencia del curso y los avances entregados si se versionan.
docs/**/*.pdf
!docs/referencia/**
!entregables/**/*.pdf
# Los diagramas SI se versionan: son fuente de los documentos, no salida
# generada. Sin ellos, quien clone el repo no puede construir los HLD.
!docs/diagramas/*.pdf

# Sistema y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
